{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/recipe",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/recipe/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/country/:slug/",
      "destination": "/country/:slug/index.html"
    },
    {
      "source": "/category/:slug/",
      "destination": "/category/:slug/index.html"
    },
    {
      "source": "/country/:slug",
      "destination": "/country/:slug/index.html"
    },
    {
      "source": "/category/:slug",
      "destination": "/category/:slug/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/faqs",
      "destination": "/faqs/index.html"
    },
    {
      "source": "/trending",
      "destination": "/trending/index.html"
    },
    {
      "source": "/recipes",
      "destination": "/recipes/index.html"
    },
    {
      "source": "/guides/dum-cooking",
      "destination": "/guides/dum-cooking/index.html"
    },
    {
      "source": "/eid-recipes",
      "destination": "/eid-recipes/index.html"
    },
    {
      "source": "/ramadan-recipes",
      "destination": "/ramadan-recipes/index.html"
    }
  ],
  "buildCommand": "python3 build_site.py",
  "outputDirectory": "."
}
